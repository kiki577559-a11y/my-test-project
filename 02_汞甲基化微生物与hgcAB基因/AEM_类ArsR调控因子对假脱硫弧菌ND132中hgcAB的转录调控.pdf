      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Transcriptional Control of hgcAB by an ArsR-Like Regulator in Pseudodesulfovibrio mercurii ND132</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/aem.01768-22</rdf:li>
        </rdf:Alt>
